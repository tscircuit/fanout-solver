{
  "name": "@tscircuit/fanout-solver",
  "version": "0.0.20",
  "description": "BGA fanout solver with coordinated bus-layer escapes for SimpleRouteJson",
  "module": "lib/index.ts",
  "type": "module",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/fanout-solver.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./lib/index.ts",
      "types": "./lib/index.ts"
    }
  },
  "scripts": {
    "start": "cosmos",
    "build:site": "cosmos-export",
    "build": "bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "benchmark": "bun benchmarks/run-benchmark.ts",
    "benchmark:srj29": "./benchmark.sh",
    "render:dataset": "bun scripts/render-dataset-pngs.ts",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tscircuit/capacity-autorouter": "0.0.718",
    "@tscircuit/solver-utils": "0.0.19",
    "graphics-debug": "0.0.96"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tsci/tscircuit.dataset-srj19-bga-passive-overlays": "github:tscircuit/dataset-srj19#c1206f3",
    "@tsci/tscircuit.dataset-srj29-bga-decoupling": "github:tscircuit/dataset-srj29-bga-decoupling#a8a1e74",
    "@tscircuit/footprinter": "0.0.394",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-match-svg": "^0.0.15",
    "circuit-json": "0.0.455",
    "react": "19.2.8",
    "react-cosmos": "7.3.0",
    "react-cosmos-plugin-vite": "7.3.0",
    "react-dom": "19.2.8",
    "vite": "8.1.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
